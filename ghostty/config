# Ghostty Terminal Configuration
# Converted from Alacritty configuration - Dracula theme
# This file should be placed at: ~/.config/ghostty/config
#-----------#


# Window configuration
window-width = 80
window-height = 45
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
#window-decoration = auto    # macOS 原生标题栏（推荐），也可改为 auto
window-theme = auto

# 状态自动记忆（最主流功能，强烈推荐）
#window-save-state = default    # 自动记住上次大小、位置、最大化状态

# 美化：轻微透明 + 背景模糊
background-opacity = 0.888
#background-blur = true          # 模糊强度，20 是主流值（可调 10~40）

# scroll-line
scrollback-limit = 50000000


#------------------#
# Font configuration
font-family = MesloLGS NF
font-size = 15

# Colors - Dracula theme
background = #282a36
foreground = #eff0eb
cursor-color = #97979b

# Selection colors
selection-background = #44475a
selection-foreground = #f8f8f2

# Basic terminal behavior
confirm-close-surface = false
quit-after-last-window-closed = true

# Mouse configuration
mouse-hide-while-typing = true

# Shell configuration (uncomment to use with tmux)
# shell-program = /bin/zsh

# Cursor configuration
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 5
cursor-invert-fg-bg = false

# Copy/Paste shortcuts (default Ghostty behavior)
# These should work by default, but if needed, the syntax would be:
# keybind = ctrl+shift+c=copy_to_clipboard
# keybind = ctrl+shift+v=paste_from_clipboard

# Font size shortcuts (default Ghostty behavior)
# These should work by default, but if needed, the syntax would be:
# keybind = ctrl+plus=increase_font_size
# keybind = ctrl+minus=decrease_font_size
# keybind = ctrl+0=reset_font_size

# Note about ANSI colors:
# Ghostty handles ANSI colors automatically. The color0-15 format from Alacritty
# is not supported. Ghostty will use the terminal's default color scheme or
# any specified theme. For full Dracula ANSI colors, you may need to:
# 1. Use a Ghostty theme file if available
# 2. Let Ghostty use system default colors
# 3. Configure colors in your shell prompt/theme instead

# For more advanced customization, see Ghostty documentation at:
# https://ghostty.org/docs/config


#setting info
shell-integration-features = ssh-terminfo,ssh-env

